{
  "name": "common-ground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,app -c green,magenta \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "docker:setup": "node scripts/docker-setup.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "lan:up": "node scripts/lan.mjs up",
    "lan:link": "node scripts/lan.mjs link",
    "lan:down": "node scripts/lan.mjs down",
    "lan:local": "node scripts/lan.mjs local",
    "backup": "node scripts/backup.mjs",
    "test:load": "node scripts/load-test.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "friends:setup": "node scripts/friends-setup.mjs",
    "ops:status": "node scripts/ops-status.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.1.0",
    "nodemailer": "^10.0.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "vite": "^7.1.0"
  },
  "overrides": {
    "shell-quote": "1.11.0"
  }
}
