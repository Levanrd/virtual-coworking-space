APP_DOMAIN=cowork.example.com
APP_ORIGIN=https://cowork.example.com
PUBLIC_IP=replace-with-router-public-ipv4
MAX_ONLINE_USERS=20
# Only these email addresses can register; verification is still mandatory.
REGISTRATION_EMAILS=replace-with-your-email
OPS_TOKEN=replace-with-at-least-32-random-characters
BACKUP_DIR=/app/backups
CG_IMAGE_TAG=friends-beta
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-provider-user
SMTP_PASSWORD=replace-with-provider-secret
MAIL_FROM=Common Ground <hello@example.com>
# The included coturn container is hosted on the same computer. Match APP_DOMAIN.
TURN_URLS=turn:cowork.example.com:3478?transport=udp,turn:cowork.example.com:3478?transport=tcp
TURN_SECRET=replace-with-at-least-32-random-characters
RTC_RELAY_ONLY=false
# Optional: opens the public community with this existing account as its owner.
# Leave empty to keep the community closed and use private workspaces only.
COMMUNITY_OWNER_ACCOUNT_ID=
